{
  "expo": {
    "name": "سوبر ماركت أيوب",
    "slug": "ayoub-market-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ayoub-market",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#14213d",
      "resizeMode": "contain",
      "image": "./assets/splash.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayoub.market",
      "infoPlist": {
        "NSCameraUsageDescription": "نحتاج الكاميرا لمسح الباركود في نقطة البيع"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14213d"
      },
      "package": "com.ayoub.market",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "السماح للكاميرا لمسح باركود المنتجات"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "//": "Values are injected from .env by app.config.js — do NOT hardcode IPs/URLs here. Change .env → EXPO_PUBLIC_WEB_URL only.",
      "eas": {
        "projectId": "b9cc527b-7f68-4fe7-bc8c-5e17ac875f59"
      }
    }
  }
}
